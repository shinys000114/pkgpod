# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=pkgpod package server
Documentation=https://github.com/shinys000114/pkgpod
Wants=network-online.target
After=network-online.target

[Service]
User=pkgpod
Group=pkgpod
ExecStart=/usr/bin/pkgpod serve --config /etc/pkgpod/pkgpod.toml
Restart=on-failure
RestartSec=10s
# On stop the server answers the requests in flight for up to 30s.
TimeoutStopSec=45s
# Serving listeners on ports below 1024 (80, 443) without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
# /usr, /boot and /etc read-only; storages elsewhere (/srv, ...) stay
# writable for the pkgpod user.
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
